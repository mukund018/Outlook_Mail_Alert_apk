<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/background"
        android:contentDescription="Background Image" />

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:title="Outlook Ring Alert"
            android:background="#4DFFFFFF"
            app:titleCentered="true" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Spacer to reveal the face in the background -->
            <View
                android:layout_width="match_parent"
                android:layout_height="220dp" />

            <!-- Master Control Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#33FFFFFF"
                app:strokeColor="#66FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="App Status"
                            android:textColor="#000000"
                            android:shadowColor="#40000000"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="1"
                            android:textAppearance="?attr/textAppearanceTitleLarge" />

                        <TextView
                            android:id="@+id/tvAppStatusDescription"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="App is currently monitoring"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAppEnabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Reliability Dashboard Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#33FFFFFF"
                app:strokeColor="#66FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reliability Checklist"
                        android:textColor="#000000"
                        android:shadowColor="#40000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="1"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:layout_marginBottom="12dp" />

                    <!-- Notification Access -->
                    <LinearLayout
                        android:id="@+id/layoutNotificationAccess"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">
                        <TextView
                            android:id="@+id/tvIconNotificationAccess"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="❌"
                            android:layout_marginEnd="12dp" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Notification Listener Access"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                    </LinearLayout>

                    <!-- Post Notifications -->
                    <LinearLayout
                        android:id="@+id/layoutPostNotifications"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">
                        <TextView
                            android:id="@+id/tvIconPostNotifications"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="❌"
                            android:layout_marginEnd="12dp" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Post Notification Permission"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                    </LinearLayout>

                    <!-- Notification Channel -->
                    <LinearLayout
                        android:id="@+id/layoutChannelStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">
                        <TextView
                            android:id="@+id/tvIconChannelStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="❌"
                            android:layout_marginEnd="12dp" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Alert Channel (Must be ON)"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                    </LinearLayout>

                    <!-- Do Not Disturb -->
                    <LinearLayout
                        android:id="@+id/layoutDNDStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">
                        <TextView
                            android:id="@+id/tvIconDNDStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="❌"
                            android:layout_marginEnd="12dp" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Do Not Disturb (Must be OFF)"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                    </LinearLayout>

                    <!-- Ringer Volume -->
                    <LinearLayout
                        android:id="@+id/layoutRingerVolume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">
                        <TextView
                            android:id="@+id/tvIconRingerVolume"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="❌"
                            android:layout_marginEnd="12dp" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ringer Volume (Must be ON)"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                    </LinearLayout>

                    <!-- Battery Optimization -->
                    <LinearLayout
                        android:id="@+id/layoutBatteryOptimization"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">
                        <TextView
                            android:id="@+id/tvIconBatteryOptimization"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="❌"
                            android:layout_marginEnd="12dp" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Battery Optimization Disabled"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Tap any ❌ to fix."
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:alpha="0.7" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Active Window Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#33FFFFFF"
                app:strokeColor="#66FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active Ringing Hours"
                        android:textColor="#000000"
                        android:shadowColor="#40000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="1"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="App will only ring during these hours."
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStartTime"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="From: 12:00 AM" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" to "
                            android:layout_marginHorizontal="8dp"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEndTime"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="To: 06:00 AM" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectRingtone"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Select Ringtone"
                        app:icon="@android:drawable/ic_menu_agenda" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestRinging"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Test Ringing Now"
                        android:backgroundTint="#1A000000"
                        app:icon="@android:drawable/ic_lock_silent_mode_off" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Activity Log Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#33FFFFFF"
                app:strokeColor="#66FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recent Activity Log"
                        android:textColor="#000000"
                        android:shadowColor="#40000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="1"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvEventLogs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No recent activity"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Device specific tips: dontkillmyapp.com"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:layout_marginBottom="16dp"
                android:alpha="0.6" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
